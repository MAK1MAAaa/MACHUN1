# 本机：先 pnpm db:tunnel；部署：改用 1Panel MySQL 容器主机名
DATABASE_URL=mysql://machun_app:CHANGE_ME@127.0.0.1:13306/machun1
# Docker / HTTPS 反代必须填写最终浏览器访问地址，不含子路径
# MACHUN_PUBLIC_ORIGIN=https://chuni.example.com
# 本机默认 4399；Docker 固定 1650
# MACHUN_PORT=4399
# MACHUN_DATA_DIR=.machun.local
# 本机默认弹窗；Docker 固定 companion，使用 pnpm login:remote
# MACHUN_BINDING_MODE=companion
