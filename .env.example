# Optional local automatic login. Never use a VITE_ prefix for credentials.
# Rin and Otogame automatically select BEMANICN and share these BCN credentials.
# Values are read only after a verified official login form is ready.
# Empty forms are filled and submitted once per binding window. Failures are not retried.
# Complete CAPTCHA, two-factor checks, or new authorization prompts yourself.
# Quote values containing # or spaces. Do not commit or share a populated .env.
BCN_EMAIL=
BCN_PASSWORD=
MUNET_USERNAME=
MUNET_PASSWORD=
