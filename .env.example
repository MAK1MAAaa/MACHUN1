# 本机：先 pnpm db:tunnel。网页账号 root / pwd，数据库只保存 SHA-256("pwd")。
DATABASE_URL=mysql://machun_app:123456@127.0.0.1:13306/machun1
# Docker 编排已预设当前 1Panel 的 MySQL 容器地址和连接密码，不需要 .env；镜像不包含数据库凭据。
# 自定义数据库时覆盖 DATABASE_URL；可选 HTTPS 反代时填写最终访问地址。
# MACHUN_PUBLIC_ORIGIN=https://chuni.example.com
# 本机默认 4399；Docker 公网 IP 访问固定 1650。本轮本地测试也使用 1650。
# MACHUN_PORT=4399
# MACHUN_DATA_DIR=.machun.local
# 本机默认弹窗；Docker 固定 companion，使用 pnpm login:remote
# MACHUN_BINDING_MODE=companion
