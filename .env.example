# MySQL through pnpm db:tunnel. pnpm db:setup generates a random app password.
# Application account requires only SELECT, INSERT, UPDATE, DELETE on machun1.*.
# Generated example: mysql://machun_app:PASSWORD@127.0.0.1:13306/machun1
DATABASE_URL=
# Used only by the explicitly invoked pnpm db:setup administration command.
MACHUN_MYSQL_CONTAINER=1Panel-mysql-3Wrt

# Optional local automatic login for the root web account only. Never use a VITE_ prefix.
# Rin and Otogame automatically select BEMANICN and share these BCN credentials.
# Values are read only after a verified official login form is ready.
# Empty forms are filled and submitted once per binding window. Failures are not retried.
# Complete CAPTCHA, two-factor checks, or new authorization prompts yourself.
# Quote values containing # or spaces. Do not commit or share a populated .env.
BCN_EMAIL=
BCN_PASSWORD=
MUNET_USERNAME=
MUNET_PASSWORD=
