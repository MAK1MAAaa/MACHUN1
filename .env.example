# Docker Compose / 1Panel settings. Portal passwords are never saved by this branch.
# The browser access account is machun. Set a random password of at least 12 characters.
# Set the actual external address, including http:// or https:// and port if needed.
MACHUN_PUBLIC_ORIGIN=http://127.0.0.1:4399
MACHUN_ACCESS_PASSWORD=replace-with-a-long-random-password
MACHUN_PUBLISH_PORT=4399
